 "lines": [
  {
   "id": "l01",
   "text": "Vous voulez construire votre maison ?",
   "start": 1.6,
   "end": 3.147
  },
  {
   "id": "l02",
   "text": "BTCS ou parpaing : lequel coûte réellement moins cher ?",
   "start": 3.7,
   "end": 7.566
  },
  {
   "id": "l03",
   "text": "Attention !",
   "start": 10.7,
   "end": 11.344
  },
  {
   "id": "l04",
   "text": "Le bloc le moins cher à l'achat n'est pas forcément celui qui permet de construire au meilleur coût.",
   "start": 11.6,
   "end": 15.772
  },
  {
   "id": "l05",
   "text": "Il faut regarder l'ensemble des travaux.",
   "start": 16.3,
   "end": 18.04
  },
  {
   "id": "l06",
   "text": "Premier avantage : la pose.",
   "start": 20.4,
   "end": 22.242
  },
  {
   "id": "l07",
   "text": "Les BTCS autobloquants d'OHEL sont conçus pour s'assembler sans mortier courant entre les blocs, selon le procédé prévu.",
   "start": 22.7,
   "end": 28.657
  },
  {
   "id": "l08",
   "text": "Cela peut réduire les matériaux de pose nécessaires.",
   "start": 29.4,
   "end": 31.502
  },
  {
   "id": "l09",
   "text": "Deuxième avantage : le temps.",
   "start": 33.8,
   "end": 35.456
  },
  {
   "id": "l10",
   "text": "Grâce à l'assemblage autobloquant, le montage peut être simplifié et plus rapide, selon les conditions du chantier.",
   "start": 36.0,
   "end": 41.337
  },
  {
   "id": "l11",
   "text": "Troisième avantage : les finitions.",
   "start": 44.4,
   "end": 46.367
  },
  {
   "id": "l12",
   "text": "Avec son aspect naturel, le BTCS peut rester apparent lorsque la conception et la protection des murs le permettent.",
   "start": 47.0,
   "end": 52.698
  },
  {
   "id": "l13",
   "text": "Certains travaux de crépissage peuvent ainsi être évités.",
   "start": 53.1,
   "end": 55.542
  },
  {
   "id": "l14",
   "text": "Selon le projet, les BTCS peuvent également être utilisés en murs porteurs ou en remplissage.",
   "start": 58.0,
   "end": 62.804
  },
  {
   "id": "l15",
   "text": "Une étude structurelle permet d'identifier les solutions les plus adaptées.",
   "start": 63.3,
   "end": 66.546
  },
  {
   "id": "l16",
   "text": "Mais alors, combien peut-on réellement économiser ?",
   "start": 69.4,
   "end": 72.127
  },
  {
   "id": "l17",
   "text": "Pour le savoir, il faut comparer deux devis complets.",
   "start": 72.6,
   "end": 75.219
  },
  {
   "id": "l18",
   "text": "Matériaux, mortier, main-d'œuvre, structure, finitions et transport : tout compte !",
   "start": 75.8,
   "end": 80.758
  },
  {
   "id": "l19",
   "text": "Les économies réelles dépendent de chaque projet.",
   "start": 81.4,
   "end": 83.588
  },
  {
   "id": "l20",
   "text": "Le BTCS offre une autre façon d'envisager votre construction, avec une esthétique naturelle et des possibilités d'optimisation à étudier.",
   "start": 86.0,
   "end": 93.018
  },
  {
   "id": "l21",
   "text": "En Côte d'Ivoire, OHEL INTERNATIONAL est votre spécialiste de la construction en Blocs de Terre Comprimée Stabilisée.",
   "start": 95.3,
   "end": 100.709
  },
  {
   "id": "l22",
   "text": "Vous avez un terrain et un projet de construction ?",
   "start": 103.0,
   "end": 104.936
  },
  {
   "id": "l23",
   "text": "Envoyez votre plan à OHEL INTERNATIONAL sur WhatsApp pour étudier votre projet en BTCS.",
   "start": 105.4,
   "end": 110.178
  },
  {
   "id": "l24",
   "text": "Contactez-nous au 07 07 63 03 35.",
   "start": 110.7,
   "end": 114.743
  },
  {
   "id": "l25",
   "text": "Abonnez-vous et activez la cloche pour découvrir nos prochaines vidéos !",
   "start": 117.0,
   "end": 120.195
  },
  {
   "id": "l26",
   "text": "OHEL INTERNATIONAL.",
   "start": 121.2,
   "end": 122.534
  },
  {
   "id": "l27",
   "text": "Construisons autrement.",
   "start": 122.9,
   "end": 124.082
  },
  {
   "id": "l28",
   "text": "Construisons durablement.",
   "start": 124.4,
   "end": 125.793
  }
 ],
